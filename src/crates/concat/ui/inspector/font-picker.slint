// The font picker: the title's family on the trigger, and a list of every
// family the title can be set in, searched as it is typed into, each name
// drawn in its own face. A family this machine does not have - a preset
// or a project shared from one that did - turns the trigger red and says
// so, rather than quietly showing the face it fell back to.

import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { SearchField } from "controls.slint";
import { Tip } from "../primitives/tooltip.slint";
import { ListView } from "std-widgets.slint";
import { Glass, GlassKind } from "../primitives/glass.slint";
import { GlassChrome } from "../primitives/glass-frost.slint";

/// The list the picker shows, searched by Rust: Slint cannot filter a model,
/// so the query goes out and the families that match come back.
export global FontSearch {
    in property <[string]> matches;
    callback query-changed(text: string);
}

export component FontPicker inherits Rectangle {
    /// The family the title names, as written.
    in property <string> family;
    /// Nothing on this machine has that family.
    in property <bool> missing;
    callback picked(family: string);
    /// A font of your own, from a file: the list's last row, so the row the
    /// trigger sits in gives all its width to the family's name.
    callback import-font();

    height: Theme.h;
    horizontal-stretch: 1;
    border-radius: Theme.r;
    background: root.missing ? Theme.danger-wash
        : touch.has-hover ? Theme.field-hover : Theme.field;
    border-width: 1px;
    border-color: root.missing ? Theme.danger : Theme.line;

    /// A long family name ("Noto Sans CJK SC") steps down a size before it
    /// elides in a narrow inspector, and the whole name is in the tip. By
    /// length rather than by measuring: the trigger's own width depends on
    /// its words, and measuring against it would loop.
    property <bool> long: root.family.character-count > 13;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 6px;

        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.missing
                ? I18n.t("textPanel.fontNotFound") + " · " + root.family
                : root.family;
            color: root.missing ? Theme.danger : Theme.fg;
            // The name in its own face, unless there is no such face.
            font-family: root.missing ? "" : root.family;
            font-size: root.long ? Theme.fs-sm : Theme.fs;
            font-weight: root.missing ? Theme.weight-title : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                glyph: Glyph.chevron-down;
                size: 12px;
                tint: root.missing ? Theme.danger : Theme.fg-muted;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            FontSearch.query-changed("");
            GlassChrome.refresh();
            list.show();
        }
    }

    Tip {
        text: root.missing ? I18n.t("textPanel.fontNotFoundTip")
            : root.long ? root.family : "";
        active: touch.has-hover;
    }

    list := PopupWindow {
        // Wider than a narrow trigger, so every family reads whole; it grows
        // leftwards, into the panel, since the inspector sits at the right.
        x: Math.min(0px, root.width - self.width);
        y: root.height + 4px;
        width: Math.max(root.width, 280px);
        height: 300px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: transparent;
            border-width: 1px;
            border-color: Theme.glass-edge;
            border-radius: Theme.r;
            drop-shadow-blur: Theme.glass-shadow-blur;
            drop-shadow-offset-y: Theme.glass-shadow-y;
            drop-shadow-color: Theme.glass-shadow;
            clip: true;
            Glass {
                width: 100%;
                height: 100%;
                border-radius: parent.border-radius;
                kind: GlassKind.menu;
            }

            VerticalLayout {
                padding: 6px;
                spacing: 6px;

                search := SearchField {
                    placeholder: I18n.t("textPanel.searchFonts");
                    esc-passes: true;
                    edited(text) => { FontSearch.query-changed(text); }
                    init => { self.focus(); }
                }

                if FontSearch.matches.length == 0: Text {
                    text: I18n.t("textPanel.noFontsMatch");
                    color: Theme.fg-dim;
                    font-size: Theme.fs;
                    horizontal-alignment: center;
                    vertical-stretch: 1;
                }

                // Virtual: a machine can have hundreds of families, and
                // each row is set in its own face.
                if FontSearch.matches.length > 0: ListView {
                    vertical-stretch: 1;
                    for name in FontSearch.matches: Rectangle {
                        height: 28px;
                        border-radius: Theme.r-sm;
                        background: row.has-hover ? Theme.field-hover : transparent;

                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: name;
                            font-family: name;
                            font-size: Theme.fs;
                            color: name == root.family ? Theme.accent : Theme.fg;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        row := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.picked(name);
                                list.close();
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                Rectangle {
                    height: 28px;
                    border-radius: Theme.r-sm;
                    background: imp.has-hover ? Theme.field-hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                glyph: Glyph.import;
                                size: 13px;
                                tint: Theme.fg-muted;
                            }
                        }
                        Text {
                            text: I18n.t("textPanel.importFont");
                            font-size: Theme.fs;
                            color: Theme.fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    imp := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            list.close();
                            root.import-font();
                        }
                    }
                }
            }
        }
    }
}
